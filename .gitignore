# Whitelist .gitignore: everything is ignored unless listed below.
# This makes it impossible to commit extracted game files, exes, dumps, Ghidra
# databases, decomp output or build output by accident. To track a new file, add it here.

# 1. Ignore everything.
/*
/**/*

# 2. Re-include directories so git can descend into them.
!*/

# 3. Top-level project files.
!/.gitignore
!/.gitattributes
!/Cargo.toml
!/Cargo.lock
!/rust-toolchain.toml
!/README.md
!/AGENTS.md
!/CREDITS.md
!/NOTICE
!/LICENSE-MIT
!/LICENSE-APACHE
# The built mod DLL (committed by the testing build) and its GitHub workflow.
!/bbs-air-physics.dll
# The OpenKH mod manifest.
!/mod.yml
!/.github/workflows/*.yml

# 4. Documentation (notes only: no dumps, no decompiled code, no tables copied from the game).
!/docs/*.md
# Helper scripts for the tester threads and versions.
!/tools/testers/*.py

# 5. Crate sources and manifests.
!/crates/*/Cargo.toml
!/crates/*/README.md
!/crates/*/src/**/*.rs
!/crates/*/tests/**/*.rs
!/crates/*/build.rs

# 6. Testers' folders (traces, logs and notes for their threads).
!/testers/**

# 7. Never track these, even if a rule above would match.
/target/
/local/
*.exe
*.c
*.bin
*.dat
*.dmp
*.gzf
*.gpr
*.rep
.obsidian/
